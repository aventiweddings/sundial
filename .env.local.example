# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ───────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# https://dashboard.stripe.com/webhooks — endpoint: /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create in Stripe dashboard (Products > Add product)
STRIPE_SOLO_MONTHLY_PRICE_ID=price_...
STRIPE_SOLO_ANNUAL_PRICE_ID=price_...
STRIPE_STUDIO_MONTHLY_PRICE_ID=price_...
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_...
STRIPE_AGENCY_MONTHLY_PRICE_ID=price_...
STRIPE_AGENCY_ANNUAL_PRICE_ID=price_...

# ─── App ─────────────────────────────────────────────────────────────────────
# No trailing slash
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Optional ────────────────────────────────────────────────────────────────
# Used for driving times — falls back to OSRM (free) if not set
# GOOGLE_MAPS_API_KEY=AIza...
